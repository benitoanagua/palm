{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "auto",
    "allowImportingTsExtensions": false,
    "types": ["vite/client"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "cosmos-export"]
}
