{
  "name": "@palm/icons",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "description": "PALM Tabler Icons dataset for pm-icon.",
  "keywords": [
    "palm",
    "design-system",
    "icons",
    "tabler",
    "pm-icon"
  ],
  "homepage": "https://github.com/benitoanagua/palm",
  "bugs": {
    "url": "https://github.com/benitoanagua/palm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benitoanagua/palm.git",
    "directory": "packages/icons"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "lint": "node ../../tooling/lint/package-rules.mjs icons",
    "generate": "node ../../tooling/generate-tabler-data.mjs",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate"
  },
  "devDependencies": {
    "@tabler/icons": "3.46.0",
    "typescript": "^5.7.0"
  }
}
