{
  "name": "@palm/components",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "license": "MIT",
  "description": "PALM canonical Web Components (pm-*).",
  "keywords": [
    "palm",
    "design-system",
    "components",
    "stencil",
    "web-components"
  ],
  "homepage": "https://github.com/benitoanagua/palm",
  "bugs": {
    "url": "https://github.com/benitoanagua/palm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benitoanagua/palm.git",
    "directory": "packages/components"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    }
  },
  "dependencies": {
    "@palm/icons": "workspace:*",
    "@palm/tokens": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.38.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0"
  },
  "scripts": {
    "build": "stencil build --docs-readme false",
    "typecheck": "stencil build --dev --docs-readme false",
    "test": "stencil test --spec",
    "lint": "node ../../tooling/lint/package-rules.mjs components"
  }
}
