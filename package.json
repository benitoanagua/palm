{
  "name": "palm-design-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "node tooling/lint/design-rules.mjs && turbo lint",
    "cosmos": "pnpm --filter @palm/cosmos cosmos",
    "build:cosmos": "pnpm --filter @palm/cosmos build",
    "check": "pnpm check:framework && pnpm check:api && pnpm check:docs-links && pnpm check:dependencies && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:package-publish && pnpm build:cosmos",
    "check:package-publish": "node tooling/validation/package-publish.mjs",
    "release": "node -e \"if(process.env.PALM_ALLOW_PUBLISH!=='1'){console.error('release bloqueado: define PALM_ALLOW_PUBLISH=1 para publicar');process.exit(1)}\" && changeset publish",
    "version-packages": "changeset version",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:framework": "node tooling/validation/no-lit.mjs",
    "check:api": "node tooling/validation/public-api.mjs",
    "check:docs-links": "node tooling/validation/docs-links.mjs",
    "check:dependencies": "node tooling/validation/dependency-consistency.mjs",
    "test:e2e": "pnpm --filter @palm/cosmos test:e2e",
    "cosmos:e2e": "pnpm --filter @palm/cosmos exec playwright test --workers=2",
    "test:e2e:update": "pnpm --filter @palm/cosmos exec playwright test --workers=2 --update-snapshots",
    "test:e2e:ui": "pnpm --filter @palm/cosmos exec playwright test --ui"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
