{
  "name": "palm-design-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "node tooling/lint/design-rules.mjs && turbo lint",
    "storybook": "pnpm --filter @palm/storybook storybook",
    "build:storybook": "pnpm --filter @palm/storybook build-storybook",
    "showcase": "pnpm --filter @palm/showcase dev",
    "build:showcase": "pnpm --filter @palm/showcase build",
    "test:showcase": "pnpm --filter @palm/showcase test",
    "test:visual": "pnpm --filter @palm/testing test:visual",
    "test:visual:update": "pnpm --filter @palm/testing test:visual -- --update-snapshots",
    "check": "pnpm check:icons && pnpm check:framework && pnpm check:api && pnpm check:docs-links && pnpm check:dependencies && pnpm check:matrix && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:storybook",
    "release": "changeset publish",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:icons": "node tooling/validation/no-legacy-icons.mjs",
    "test:contracts": "pnpm --filter @palm/testing test:contracts",
    "test:a11y": "pnpm --filter @palm/testing test:a11y",
    "format:repair": "prettier --write .",
    "check:framework": "node tooling/validation/no-lit.mjs",
    "check:dependencies": "node tooling/validation/dependency-consistency.mjs",
    "check:api": "node tooling/validation/public-api.mjs",
    "check:docs-links": "node tooling/validation/docs-links.mjs",
    "test:e2e": "node tooling/run-e2e.mjs",
    "check:matrix": "node tooling/validation/component-matrix.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
